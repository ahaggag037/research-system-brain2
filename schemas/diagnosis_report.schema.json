{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixhua/diagnosis_report.schema.json",
  "title": "FixHUA M0.2 research-expanded evidence summary",
  "type": "object",
  "required": ["schemaVersion", "reportType", "truthState", "observability", "platformCapabilities", "pressure", "memory", "candidateState", "limitations"],
  "properties": {
    "schemaVersion": {"const": 2},
    "reportType": {"const": "CAPABILITY_PRESSURE_SNAPSHOT_NOT_INCIDENT_ATTRIBUTION"},
    "truthState": {"const": "OBSERVATION_SUMMARY_NOT_CAUSAL_DIAGNOSIS"},
    "candidateState": {"enum": ["NORMAL_OR_UNDETERMINED", "PRESSURE_SIGNAL_PRESENT", "UNKNOWN_OR_MIXED"]},
    "platformCapabilities": {"type": "object"}
  },
  "additionalProperties": true
}
